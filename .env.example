# ==============================================================================
# FlowEdit — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real API keys.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (frontend URL)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ── Storage ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=storage/uploads
FRAMES_DIR=storage/frames
PROCESSED_DIR=storage/processed
OUTPUT_DIR=storage/outputs
MAX_UPLOAD_MB=500

# ── Model weight paths ─────────────────────────────────────────────────────────
SAM_CHECKPOINT=weights/sam_vit_h_4b8939.pth
SAM_MODEL_TYPE=vit_h

GROUNDING_DINO_CONFIG=GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_WEIGHTS=weights/groundingdino_swint_ogc.pth

RAFT_CHECKPOINT=weights/raft-things.pth
PROPAINTER_CHECKPOINT=weights/ProPainter.pth

# ── Batch sizes (lower if you hit CUDA OOM) ────────────────────────────────────
INFER_BATCH_SIZE=8
RAFT_BATCH_SIZE=4

# ── Replicate cloud GPU fallback ───────────────────────────────────────────────
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
USE_REPLICATE_FALLBACK=false
